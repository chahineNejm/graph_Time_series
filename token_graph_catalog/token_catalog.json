  "tokens": [
    {
      "id": "START",
      "status": "synthetic",
      "class": "control",
      "core": true,
      "description": "Synthetic start node for graph visualization.",
      "reads": [],
      "writes": [],
      "parents": [],
      "next": [
        "DataAugmentation",
