        "features.raw_history"
      ],
      "writes": [
        "historical_features.flair_history",
        "metadata.flair_shift"
      ],
      "parents": [
        "START"
      ],
      "next": [
        "PeriodSelection"
      ]
    },
    {
      "id": "DataAugmentation",
      "status": "notebook",
      "class": "cleaning",
      "core": true,
      "description": "Notebook prototype that jitters and smooths history for train-side experiments.",
